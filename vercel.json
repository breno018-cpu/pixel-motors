{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!.*\\.).*)",
          "destination": "/index.html"
        }
      ]
    },
    "backend": {
      "root": "Folha/backend",
      "framework": "express",
      "entrypoint": "server.js"
    },
    "frontend": {
      "root": "Folha/frontend",
      "framework": "vite",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/((?!.*\\.).*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
